# Copy this file to .env and adjust values. Never commit your real .env file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database: "sqlite" (default, zero setup) or "mysql"
DB_ENGINE=sqlite
DB_NAME=campus_compass
DB_USER=campus_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Email: console backend prints OTP emails in the terminal during development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Campus Compass <no-reply@campuscompass.local>

# Optional: restrict registration to one email domain, e.g. college.edu (leave empty to allow all)
ALLOWED_EMAIL_DOMAIN=

# Campus locator map centre. Demo buildings are placed relative to this point.
# The default is a neutral reference point, NOT a real college. Set your own campus centre here.
CAMPUS_CENTER_LAT=20.5937
CAMPUS_CENTER_LNG=78.9629
CAMPUS_MAP_ZOOM=17
